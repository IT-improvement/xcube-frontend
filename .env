PORT=3000
REACT_APP_AUTH_API_URL=http://localhost:8081
REACT_APP_BACKOFFICE_API_URL=http://localhost:8082
# The browser requests tiles directly from XCube Server; legends, coordinates, statistics, and timeseries use the Backoffice proxy.
REACT_APP_XCUBE_URL=http://localhost:8080
REACT_APP_USE_MOCK_API=false
DANGEROUSLY_DISABLE_HOST_CHECK=true
# Admin console (UR-62, separate app xcube-admin-frontend). The 관리자 menu links here. Unset: /admin in a
# production build (same origin), http://<this host>:3010/admin in development. Set it in .env.development.local
# when the console runs elsewhere, e.g. REACT_APP_ADMIN_URL=http://192.168.75.112:3010/admin
